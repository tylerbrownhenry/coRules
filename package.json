{
  "name": "corules",
  "version": "0.1.0",
  "description": "Professional configuration generator for AI coding assistants across multiple IDE platforms",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "corules": "./dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin/cli.js",
    "dev": "ts-node src/bin/cli.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install",
    "prepublishOnly": "npm run test && npm run lint && npm run build"
  },
  "keywords": [
    "ai",
    "rules",
    "ide",
    "vscode",
    "cursor",
    "github",
    "copilot",
    "automation",
    "configuration",
    "generator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.2.0",
    "commander": "^10.0.0",
    "fs-extra": "^11.1.0",
    "inquirer": "^9.1.4",
    "mustache": "^4.2.0",
    "ora": "^6.3.0",
    "yaml": "^2.2.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.1",
    "@types/inquirer": "^9.0.3",
    "@types/jest": "^29.5.0",
    "@types/mustache": "^4.2.2",
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^8.37.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "lint-staged": "^13.2.0",
    "prettier": "^2.8.7",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/corules.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/corules/issues"
  },
  "homepage": "https://github.com/yourusername/corules#readme",
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}